rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      // In this project, admin actions are primarily handled via the Admin SDK in the backend.
      // However, we can add a check if we store an 'admin' role in the user document.
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isBackendService() {
      // Backend service accounts should have a custom claim set by the admin service.
      return isAuthenticated() && (
        request.auth.token.backendService == true ||
        request.auth.token.admin == true
      );
    }

    // 1. Users Collection
    match /users/{userId} {
      // Public profiles: allowed for authenticated users to see who they are trading with.
      // In production, consider moving 'fcmToken' to a private sub-document.
      allow read: if isAuthenticated();
      
      allow create: if isOwner(userId);
      
      // Users can update their own profile EXCEPT for critical fields.
      allow update: if isOwner(userId) && 
                      !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['verificationStatus', 'role', 'phoneNumber', 'createdAt', 'lastNotificationAt', 'lastNotifications', 'verificationReviewRequestedAt', 'kycData', 'legalIdentity', 'trustMetrics']);
    }

    // 1a. Public Profiles (Safe, public-facing identity cache)
    match /publicProfiles/{uid} {
      allow read: if isAuthenticated();
      // Creation and updates for sensitive fields are managed by Backend Admin SDK
      allow create, delete: if false;
      allow update: if isBackendService();
    }

    // 2. Notifications (Private to owner, read-only via client)
    match /notifications/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // Only written by Backend/Admin SDK via collectionGroup or direct ref

      match /items/{itemId} {
        allow read: if isOwner(userId);
        // Allow user to mark as read, but not delete or change content
        allow update: if isOwner(userId) && 
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
    }

    // 3. Chats (Participants only)
    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      // Allow participants to update metadata (unreadCount, lastMessage)
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['unreadCount', 'lastMessage', 'lastMessageAt', 'status']);
      allow create, delete: if false; // Created by backend when offer is accepted
    }

    // 4. Messages (Subcollection of chats? No, based on mobile code it's messages/{chatId}/messages/{msgId})
    match /messages/{chatId}/messages/{msgId} {
      // Check parent chat document for participant status
      allow read: if isAuthenticated() && 
                    request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      allow create: if isAuthenticated() && 
                      request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                      request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    // 5. Supply Ads & Demand Posts
    match /supplyAds/{adId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                      request.resource.data.supplierId == request.auth.uid &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationStatus == 'approved';
      allow update, delete: if isAuthenticated() && resource.data.supplierId == request.auth.uid;
    }

    match /demandPosts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                      request.resource.data.businessId == request.auth.uid &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationStatus == 'approved';
      allow update, delete: if isAuthenticated() && resource.data.businessId == request.auth.uid;
    }

    // 6. Offers
    match /offers/{offerId} {
      allow read: if isAuthenticated() && 
                    (request.auth.uid == resource.data.supplierId || request.auth.uid == resource.data.businessId);
      allow create: if isAuthenticated() && 
                      request.resource.data.supplierId == request.auth.uid &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationStatus == 'approved';
      allow update: if isAuthenticated() && 
                      (request.auth.uid == resource.data.supplierId || request.auth.uid == resource.data.businessId);
      allow delete: if false;
    }

    // 7. Admin Queue (Strictly protected)
    match /adminQueue/{docId} {
      allow read, write: if false; // Only Backend Admin SDK
    }

    // 8. Ratings & Reviews
    match /ratings/{ratingId} {
      allow read: if true; // Public reviews
      
      allow create: if isAuthenticated() && 
                      request.resource.data.reviewerId == request.auth.uid &&
                      request.resource.data.targetUserId != request.auth.uid &&
                      get(/databases/$(database)/documents/offers/$(request.resource.data.transactionId)).data.status == 'completed' &&
                      (get(/databases/$(database)/documents/offers/$(request.resource.data.transactionId)).data.supplierId == request.auth.uid ||
                       get(/databases/$(database)/documents/offers/$(request.resource.data.transactionId)).data.businessId == request.auth.uid);
      
      allow update, delete: if isBackendService(); // Only backend can remove/flag reviews
    }

    // 9. Reported Reviews
    match /reportedReviews/{reportId} {
      allow create: if isAuthenticated() &&
                      request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isBackendService();
    }

    // 10. Reports (General)
    match /reports/{reportId} {
      allow create: if isAuthenticated() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.targetUserId is string &&
        request.resource.data.reason is string &&
        request.resource.data.createdAt is string;

      allow read: if isAdmin() || isBackendService();
      allow update, delete: if false;
    }

    // Default deny for any other collections
    match /{path=**} {
      allow read, write: if false;
    }

  }
}
